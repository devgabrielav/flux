{
  "extends": "@trybe/eslint-config-frontend/typescript",
  "overrides": [
    {
      "files": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/tests/**/*.tsx",
        "setupTests.ts"
      ],
      "rules": {
        "sonarjs/no-duplicate-string": "off",
        "max-len": "off",
        "max-lines-per-function": "off",
        "no-magic-numbers": "off"
      }
    }
  ]
}
